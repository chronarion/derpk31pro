# derpk31pro default with packed scale factors: the same memory holds more experts, and every expert that is computed
# gives the same bits as in the default profile. Needs a hi2-k2 record store (HI2_DIR in config.env:
# store/convert_store.py makes one from an existing store in minutes, store/build_store.py --format hi2-k2 from the
# checkpoint) and the libraries of ./build.sh.
#  - CPU memory: 45,382 2-bit records (bank-map-256k-k2-sf6.json) in the 387 GB that hold 41,661 hi2-k1 records: a
#    record's scale factors are a base per row and 2 bits each (8.53 MB per record instead of 9.29 MB).
#  - RTX PRO 6000: 11,170 records (band-map-k2.json) in the bytes of 10,856 (the same code instead of 4 bits each).
#  - GPU memory: 9,530 experts in MXFP4 with 6-bit scale codes (K31_SF6, hbm-map-256k-final-sf6.json; 17.29 MB per
#    expert instead of 17.55 MB) in the bytes of 9,390; the MegaMoE fork unpacks them in its scale copy.
# Everything else is the default profile's.
. "$(dirname "${BASH_SOURCE[0]}")/default.env"
_d=/engine/profiles
export K31_REC_FMT=hi2-k2 K31_SF6=1
export K31_HBM_MAP=$_d/hbm-map-256k-final-sf6.json K31_BAND_MAP=$_d/band-map-k2.json
export K31_BANK_MAP=$_d/bank-map-256k-k2-sf6.json
