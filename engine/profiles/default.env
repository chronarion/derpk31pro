# derpk31pro default: Kimi K3.1 Pro on one DGX Station GB300 with the RTX PRO 6000 as a band of 2-bit experts.
#  - GPU memory: 9,390 experts in their official MXFP4 form (hbm-map-256k-final.json: rows per layer by sensitivity, sized
#    to fill what the KV cache, the prompt path's peak and a margin leave), adapting to the conversation (promotions
#    from the record store), plus 128 staging rows shared by all layers.
#  - RTX PRO 6000: 10,856 experts as 2-bit records (band-map.json), computed beside the GB300's MegaMoE call.
#  - Grace memory: 41,800 2-bit records (bank-map-256k.json, 388 GB pinned) that strong misses are staged from; a staged
#    expert serves all of its picks in the step (K31_STAGE_ALL).
#  - Resident caps (policy-joint15.json): in most layers only a token's strongest picks read a resident row; weaker
#    picks of resident experts take the expert's mean output, so MegaMoE streams fewer experts.
#  - The rest of a token's 16 picks: replaced by the expert's mean output (K31_CUT_MEAN, MEANS_DIR).
#  - Dense layers in 8-bit (int8 / FP8 / W8A16 by layer kind, MXFP4 for the KDA projection), KV cache in FP8.
#  - DSpark speculative decoding (Inferact/Kimi-K3.1-Pro-DSpark, DRAFT in config.env) with 4 draft tokens, block
#    verification, the request's top-p applied to the drafts too (K31_DRAFT_TOPP), and the drafter's sliding-window
#    layers kept as full attention for the KV manager so prefix-cache hits stay fine-grained (K31_DRAFT_FULL_KV).
#  - Prompts in 4,096-token chunks through the prompt path: every bank pick computed, the RTX band's picks in one bulk
#    request per layer, big-row int8 / W8A16 kernels, records copied by the copy engines, sparse attention in row
#    slices. Context up to 262,144 tokens (16 GiB of KV cache: one request at full length).
# Every variable can be overridden from the environment.
_d=/engine/profiles
export K31_MODE=staged K31_RANK=/rank/rank-pass1.json K31_HBM=105 K31_STRONG=3 K31_ACCEPTED=1
export K31_HBM_MAP=$_d/hbm-map-256k-final.json K31_POLICY=$_d/policy-joint15.json K31_STAGE_ALL=1
export K31_BAND_N=118 K31_BAND_MAP=$_d/band-map.json K31_BAND_SIDE=1 K31_BAND_FIN_SIDE=1 K31_BAND_SERVED=1
export K31_BAND_FUSED_LIB=librtxband_fused_v4.so K31_BAND_WAIT_S=300 K31_TAIL1=1 K31_BAND_PRIOR=1,0.69,0.43,0.24,0.14
export K31_BANK=400 K31_BANK_MAP=$_d/bank-map-256k.json K31_BANK_EXCL=1 K31_BANK_PROMOTE=0.08
export K31_PROMOTE=0.1 K31_PROMOTE_FLIGHT=48 K31_PROMOTE_WORKERS=12 K31_CREDIT_WEIGHTS=$_d/credit-weights.json
export K31_HAND_FEED=1 K31_FADV_RANDOM=1 K31_MERGE_BLOCKS=1216 K31_EXTRACT_BLOCKS=1216
export K31_CUT_MEAN=${K31_CUT_MEAN-/means/k31-expert-means.safetensors}
export K31_DENSE_FMT=routed_expert_down_proj:w8i,routed_expert_up_proj:w8i,shared_experts.gate_up_proj:fp8c,g_proj:fp8c,in_proj_qkvgfab:mxfp4dg,self_attn.o_proj:w8i,q_b_proj:w8i,fused_qkv_a_proj:w8i,*:w8a16
export K31_W8A16_CFG=$_d/w8a16-bench.json K31_MARLIN_TABLE=$_d/marlin-bench.json K31_W8_MARLIN=1 K31_MXFP4_PAD=1
export K31_W8A16_OVERRIDE='3584x7168=32,1792,4,4,3;7168x6144=32,3072,2,4,4;12288x7168=64,2432,3,4,3'
export K31_PDL=1 K31_I8_PDL=1 K31_SHARED_SIDE=3 K31_GATE_SIDE=2 K31_FUSE_UP=0 K31_DEFER=0 K31_DSA_FUSED=1
export K31_DRAFT_W8=1 K31_DRAFT_W8_HEAD=1 K31_DRAFT_W8_LAYERS='*' K31_W8I_DRAFT=1 K31_DRAFT_TOPP=1 K31_DRAFT_FULL_KV=1
export K31_PROMPT_PATH=${K31_PROMPT_PATH:-1} K31_BAND_BULK=${K31_BAND_BULK:-1}
export K31_I8_BIG_M_KERNEL=1 K31_W8A16_BIG_M=1 K31_BIGM_CFG=$_d/bigm-bench.json K31_DSA_ROW_SLICE=2048
export K31_PROMPT_CELANE=0.75 K31_PROMPT_CELANE_LANES=2 K31_PROMPT_CELANE_BUFS=2 K31_PROMPT_CELANE_XSIDE=1
DRAFT_REJECT=${DRAFT_REJECT-block}
DRAFTS=${DRAFTS:-4}
MEGAMOE_FORK=${MEGAMOE_FORK:-1}
KV_BYTES=${KV_BYTES:-17179869184}
MAXLEN=${MAXLEN:-262144}
MAX_SEQS=${MAX_SEQS:-4}
MAX_BATCHED=${MAX_BATCHED:-4096}
GPU_UTIL=${GPU_UTIL:-0.95}
CPUS=${CPUS:-0-47}
MEM_LIMIT=${MEM_LIMIT:-420g}
