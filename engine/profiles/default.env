# default (GB300 + RTX PRO 6000): the quality8 profile (ranks 0-7 staged from the bank, row caps 8,8,4,2,2, at most 6
# records per call) with the refitted mean tables, the decode split and the joint decode path. GPQA Diamond 186 of 198
# (reasoning effort max, temperature 1, top-p 0.95, 4 conversations in flight). For the faster, less close settings
# see fast.env.
. "$(dirname "${BASH_SOURCE[0]}")/quality8.env"
export K31_CUT_MEAN=/means/k31-fmeans.safetensors
