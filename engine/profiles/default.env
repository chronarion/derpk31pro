# default (GB300 + RTX PRO 6000): the quality8 profile (ranks 0-7 staged from the bank, row caps 8,8,4,2,2, at most 6
# records per call) with the refitted mean tables, the decode split and the joint decode path; since 1.1 the
# 8,192-token prompt path (prompt8k.env; the RTX band takes a chunk's picks in calls of up to 8,192 rows); since 1.2
# packed scale factors: 2-bit copies from a hi2-k2 record store (a base per row and 2-bit scale offsets) and 6-bit
# scale codes for the experts in GPU memory, so the same memory holds 9,530 experts in GPU memory (1.1: 9,390), 11,170
# on the RTX (10,856) and 45,382 in CPU memory (41,661); every expert that is computed gives the same bits. Needs
# HI2_DIR to be a hi2-k2 store (store/convert_store.py). GPQA Diamond 186 of 198 in 1.0 (reasoning effort max,
# temperature 1, top-p 0.95, 4 conversations in flight). For the faster, less close settings see fast.env.
. "$(dirname "${BASH_SOURCE[0]}")/quality8.env"
export K31_CUT_MEAN=/means/k31-fmeans.safetensors
. "$(dirname "${BASH_SOURCE[0]}")/prompt8k.env"
export K31_BAND_BULK_ROWS=8192
_d=/engine/profiles
export K31_REC_FMT=hi2-k2 K31_SF6=1
export K31_HBM_MAP=$_d/hbm-map-256k-final-sf6.json K31_BAND_MAP=$_d/band-map-k2.json K31_BANK_MAP=$_d/bank-map-256k-k2-sf6.json
