# default (GB300 + RTX PRO 6000): the quality8 profile (ranks 0-7 staged from the bank, row caps 8,8,4,2,2, at most 6
# records per call) with the refitted mean tables, the decode split and the joint decode path, and since 1.1 the
# 8,192-token prompt path (prompt8k.env; the RTX band takes a chunk's picks in calls of up to 8,192 rows). GPQA Diamond
# 186 of 198 in 1.0 (reasoning effort max, temperature 1, top-p 0.95, 4 conversations in flight). For the faster, less
# close settings see fast.env.
. "$(dirname "${BASH_SOURCE[0]}")/quality8.env"
export K31_CUT_MEAN=/means/k31-fmeans.safetensors
. "$(dirname "${BASH_SOURCE[0]}")/prompt8k.env"
export K31_BAND_BULK_ROWS=8192
