# derpk31pro without the RTX PRO 6000, with packed scale factors (see default-k2.env): 49,020 2-bit records in the
# 418 GB of CPU memory that hold 45,000 hi2-k1 records (bank-map-nortx-k2-sf6.json), 9,530 experts in GPU memory with
# 6-bit scale codes (hbm-map-256k-final-sf6-nortx.json). Needs a hi2-k2 record store. Everything else is nortx's.
. "$(dirname "${BASH_SOURCE[0]}")/nortx.env"
_d=/engine/profiles
export K31_REC_FMT=hi2-k2 K31_SF6=1
export K31_HBM_MAP=$_d/hbm-map-256k-final-sf6-nortx.json K31_BANK_MAP=$_d/bank-map-nortx-k2-sf6.json
