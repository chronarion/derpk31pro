# The 1.1 prompt path, used by default and nortx (the fast profiles keep 1.0's): prompts are read in chunks of up to
# 8,192 tokens instead of 4,096, every expert copy of a layer goes over the copy engine and starts ahead of the layer's
# plan, and PyTorch's allocator merges freed blocks, which frees the memory the larger chunks need. Prompt reading
# x1.53-1.66 (default) and x1.64-1.85 (nortx) against 1.0 at 32K-128K tokens; decode speed unchanged.
# - MAX_BATCHED=8192: vLLM's prompt chunk (--max-num-batched-tokens).
# - K31_MEGAMOE_ROWS=4096: MegaMoE's buffer stays sized for 4,096 rows; a chunk of 8,192 runs in two slices.
# - K31_PROMPT_CELANE=1.0 (1.0: 0.75), two buffers: the share of a layer's expert copies on the copy-engine lane.
# - K31_PROMPT_SPEC=1: the next layer's first copies start before its plan is known (changes are caught at the claim).
# - K31_PROMPT_EMPTY_CACHE=1: torch's cached blocks go back to the device after each prompt step.
# - ALLOC_CONF=expandable_segments:True: freed blocks of any size are merged and reused (PYTORCH_CUDA_ALLOC_CONF).
# - K31_PROMPT_FIRST_CHUNK=4096,4096 with K31_PROMPT_FIRST_ROWS=4096,8192 and K31_PROMPT_FIRST_FREE=1: a new prompt's
#   first two chunks keep 1.0's 4,096 rows (the second only where that costs no extra forward), so the expert tiers
#   follow the prompt as early as before.
export K31_MEGAMOE_ROWS=4096 K31_PROMPT_CELANE=1.0 K31_PROMPT_CELANE_BUFS=2 K31_PROMPT_SPEC=1 K31_PROMPT_EMPTY_CACHE=1
export K31_PROMPT_FIRST_CHUNK=4096,4096 K31_PROMPT_FIRST_ROWS=4096,8192 K31_PROMPT_FIRST_FREE=1
MAX_BATCHED=8192
PREFIX_UNIT=64
ALLOC_CONF=expandable_segments:True
