# derpk31pro without the RTX PRO 6000, staging table t92: each layer's staged ranks chosen by KLD bought per microsecond
# of step time for ~92 tok/s on the greedy bench (ranks 0-3 staged in the layers where staging pays most).
. "$(dirname "${BASH_SOURCE[0]}")/nortx.env"
export K31_POLICY=/engine/profiles/policy-nortx-t92.json
