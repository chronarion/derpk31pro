# derpk31pro quality with the misses of ranks 0-7 staged (see quality.env; the RTX profile has decode time to spare
# after ranks 0-3): policy-stage8.json with the wider plan (K31_STAGE_SP=8, which needs K31_DECODE_SPLIT=1), the
# per-row caps 8,8,4,2,1 and at most K31_STAGE_CAP records per decode call by weight x row prior. Everything else is
# the quality profile's.
. "$(dirname "${BASH_SOURCE[0]}")/quality.env"
_d=/engine/profiles
export K31_POLICY=$_d/policy-stage8.json K31_STAGE_SP=8 K31_DECODE_SPLIT=1
export K31_STAGE_ROWS=8,8,4,2,1 K31_STAGE_CAP=6
