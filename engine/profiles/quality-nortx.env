# derpk31pro quality without the RTX PRO 6000 (see quality.env): the nortx profile's tiers with every layer staging
# its misses of ranks 0-3 from CPU memory (policy-nortx-stage4.json), at most K31_STAGE_CAP records per decode call
# (largest routing weight first) and the per-row caps of K31_STAGE_ROWS. Everything else is the nortx profile's.
. "$(dirname "${BASH_SOURCE[0]}")/fast-nortx.env"
_d=/engine/profiles
export K31_POLICY=$_d/policy-nortx-stage4.json K31_STAGE_ALL=1
export K31_STAGE_ROWS=${K31_STAGE_ROWS-4,4,2,1,1} K31_STAGE_CAP=${K31_STAGE_CAP-4}
export K31_STAGE_PRIOR=${K31_STAGE_PRIOR-1,0.69,0.43,0.24,0.14}
