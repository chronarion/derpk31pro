# nortx (GB300 alone): the quality-nortx profile with row caps 4,4,4,2,2 and at most 6 records per call, the refitted
# mean tables, the decode split and the joint decode path; since 1.1 the 8,192-token prompt path (prompt8k.env) and
# 262 more resident expert rows (paid by the memory the allocator setting frees); since 1.2 packed scale factors
# (see default.env): 9,792 experts in GPU memory (1.1: 9,652) and 49,020 2-bit copies in CPU memory (45,000). Needs
# HI2_DIR to be a hi2-k2 store. GPQA Diamond 188 of 198 in 1.0, 183 of 198 in one run of 1.1 (reasoning effort max,
# temperature 1, top-p 0.95, 4 conversations in flight). For the faster, less close settings see fast-nortx.env.
. "$(dirname "${BASH_SOURCE[0]}")/quality-nortx.env"
export K31_STAGE_ROWS=4,4,4,2,2 K31_STAGE_CAP=6 K31_CUT_MEAN=/means/k31-fmeans.safetensors
. "$(dirname "${BASH_SOURCE[0]}")/prompt8k.env"
_d=/engine/profiles
export K31_REC_FMT=hi2-k2 K31_SF6=1
export K31_HBM_MAP=$_d/hbm-map-256k-final-sf6-nortx-plus262.json K31_BANK_MAP=$_d/bank-map-nortx-k2-sf6.json
