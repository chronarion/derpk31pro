# nortx (GB300 alone): the quality-nortx profile with row caps 4,4,4,2,2 and at most 6 records per call, the refitted
# mean tables, the decode split and the joint decode path, and since 1.1 the 8,192-token prompt path (prompt8k.env)
# and 262 more resident expert rows (9,652; paid by the memory the allocator setting frees). GPQA Diamond 188 of 198
# in 1.0, 183 of 198 in one run with 1.1's settings (reasoning effort max, temperature 1, top-p 0.95, 4 conversations
# in flight). For the faster, less close settings see fast-nortx.env.
. "$(dirname "${BASH_SOURCE[0]}")/quality-nortx.env"
export K31_STAGE_ROWS=4,4,4,2,2 K31_STAGE_CAP=6 K31_CUT_MEAN=/means/k31-fmeans.safetensors
. "$(dirname "${BASH_SOURCE[0]}")/prompt8k.env"
export K31_HBM_MAP=/engine/profiles/hbm-map-256k-final-nortx-plus262.json
