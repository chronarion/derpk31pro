# derpk31pro without the RTX PRO 6000: the GB300 alone. The RTX band's experts move into CPU memory (bank-map-nortx.json,
# 45,000 2-bit records, 418 GB pinned) and the GB300 stages ranks 0-3 of the sensitive layers from there
# (policy-nortx.json). Needs ~460 GB for the engine container: the host's free memory decides how far the bank can grow.
. "$(dirname "${BASH_SOURCE[0]}")/default.env"
_d=/engine/profiles
export K31_BAND_N=0 K31_BANK_MAP=$_d/bank-map-nortx.json K31_POLICY=$_d/policy-nortx.json
export K31_HAND_FEED=0 K31_TAIL1=0 K31_BAND_SIDE=0 K31_BAND_FIN_SIDE=0 K31_BAND_SERVED=0
MEM_LIMIT=${MEM_LIMIT_NORTX:-460g}
