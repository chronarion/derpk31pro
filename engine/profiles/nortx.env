# derpk31pro without the RTX PRO 6000: the GB300 alone. The RTX band's experts move into CPU memory (bank-map-nortx.json,
# 45,000 2-bit records, 418 GB pinned) and the GB300 stages each layer's strong misses from there by a table of KLD bought
# per microsecond of staging (policy-nortx-t92-allrows.json: ranks 0-3 in the most sensitive layers, rank 0 in most
# others, none in the cheapest), every pick of a staged expert served by its record (K31_STAGE_ALL). K31_STAGE_ROWS caps
# the staged ranks per row of a verify block (later draft rows are accepted less often): 4,4,2,1,1 = +2.8% decode for
# a 512-cut KLD of 0.0756; K31_STAGE_ROWS= (empty) turns the caps off. Needs ~460 GB for the engine
# container: the host's free memory decides how far the bank can grow.
. "$(dirname "${BASH_SOURCE[0]}")/default.env"
_d=/engine/profiles
export K31_BAND_N=0 K31_BANK_MAP=$_d/bank-map-nortx.json K31_POLICY=$_d/policy-nortx-t92-allrows.json K31_STAGE_ALL=1
export K31_HBM_MAP=$_d/hbm-map-256k-final-nortx.json K31_STAGE_ROWS=${K31_STAGE_ROWS-4,4,2,1,1}
export K31_HAND_FEED=0 K31_TAIL1=0 K31_BAND_SIDE=0 K31_BAND_FIN_SIDE=0 K31_BAND_SERVED=0 K31_BAND_PRIOR=
MEM_LIMIT=${MEM_LIMIT_NORTX:-460g}
