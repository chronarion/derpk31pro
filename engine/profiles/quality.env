# derpk31pro quality: the default profile's tiers with closeness to the official model before decode speed.
#  - Resident experts serve their picks on every rank (the default caps the ranks per layer and gives the mean to the
#    weaker picks of resident experts).
#  - Every layer stages its misses of ranks 0-3 from CPU memory (policy-stage4.json), not only rank 0 in most layers.
#  - The time this costs is bounded per call: at most K31_STAGE_CAP records are staged per decode call, the picks with
#    the largest routing weight first, and K31_STAGE_ROWS limits the staged ranks per row of a verify block (later
#    draft rows are accepted less often). K31_STAGE_CAP= (empty) lifts the cap (16 slots per call).
#    K31_STAGE_PRIOR orders the candidates by weight x the chance that their row is accepted, as K31_BAND_PRIOR does
#    for the band, so the cap keeps the picks most likely to be used.
#  - Cut picks take the mean substitute as in the default profile (K31_CUT_MEAN).
#  - The cap is per MoE call, and with K31_DECODE_SPLIT a call is one request's verify block when the batch has more
#    than 8 rows (DRAFTS=4: always). With fewer drafts set K31_DECODE_SPLIT_ROWS to the block's rows (2 for DRAFTS=1)
#    so that requests in flight together do not share one call's cap.
# Everything else is the default profile's. Every variable can be overridden from the environment.
. "$(dirname "${BASH_SOURCE[0]}")/default.env"
_d=/engine/profiles
export K31_POLICY=$_d/policy-stage4.json K31_STAGE_ALL=1
export K31_STAGE_ROWS=${K31_STAGE_ROWS-4,4,2,1,1} K31_STAGE_CAP=${K31_STAGE_CAP-6}
export K31_STAGE_PRIOR=${K31_STAGE_PRIOR-1,0.69,0.43,0.24,0.14}
