# derpk31pro site configuration: copy this file to config.env and edit the paths. Every variable can also be set in
# the environment (the environment wins). Everything below fits on one 4 TB NVMe drive (~3.1 TB in all).

# The official checkpoint, moonshotai/Kimi-K3.1-Pro (~1.56 TB): the engine reads its resident experts from it
NATIVE=/models/moonshotai/Kimi-K3.1-Pro

# The stripped checkpoint: every tensor except the routed experts (~107 GB; store/run_kstrip.sh writes it)
MODEL=/models/k31-stripped

# The record store: each expert's 2-bit hi2 record and its lo2 complement (~1.4 TB; store/build_store.py writes it).
# The Grace bank, the RTX band and promotions to GPU memory all read from here.
HI2_DIR=/models/k31-hi2

# The DSpark drafter for speculative decoding (Inferact/Kimi-K3.1-Pro-DSpark, the final release; used when the profile
# sets DRAFTS). The profiles' KV cache size (16 GiB for one 262,144-token request) is for this drafter at 4 drafts.
DRAFT=/models/Inferact/Kimi-K3.1-Pro-DSpark

# The directory holding k31-expert-means.safetensors, the experts' average outputs for skipped picks (591 MB:
#   hf download chronarion/derpk31pro-means k31-expert-means.safetensors --local-dir /models/k31-means).
# Without it, start with K31_CUT_MEAN= (empty): skipped picks then add nothing, which raises KLD.
MEANS_DIR=/models/k31-means

# Caches (vLLM, Triton, DeepGEMM and FlashInfer JIT), engine logs, and the KLD harness's files ($STATE/kld)
STATE=./state

# GPUs: found by name with nvidia-smi (GB300, RTX PRO 6000). Set the UUIDs only if that fails.
# GB=GPU-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# RTX=GPU-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# The server's port (OpenAI-compatible API on 127.0.0.1)
PORT=8113
